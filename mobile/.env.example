# Base URL of the SuperPay API (the server/ folder in this repo).
#
#  - Android emulator  -> http://10.0.2.2:4000/api   (this is the default when unset)
#  - Physical device   -> http://<your computer's LAN IP>:4000/api   e.g. http://192.168.1.20:4000/api
#  - Production        -> https://api.your-domain.com/api
EXPO_PUBLIC_API_URL=http://10.0.2.2:4000/api
