# Copy to .env and adjust.
NODE_ENV=development
PORT=4000
# Local MongoDB (or a MongoDB Atlas connection string)
MONGODB_URI=mongodb://127.0.0.1:27017/superpay
# REQUIRED: at least 16 characters. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=30d
# Comma separated list of allowed origins, or * for any (native apps do not send an Origin header)
CORS_ORIGIN=*
# Per-transaction limit in rupees (simulated)
TXN_LIMIT_RUPEES=100000
# Balance given to every new demo profile, in rupees
STARTER_BALANCE_RUPEES=12540
